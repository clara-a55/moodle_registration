<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="users">
        <xs:complexType>
            <xs:sequence>

                <xs:element name="user" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>

                            <!-- ID: numeric, maximum 5 digits -->
                            <xs:element name="id">
                                <xs:simpleType>
                                    <xs:restriction base="xs:positiveInteger">
                                        <xs:maxInclusive value="99999"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <!-- Username: required -->
                            <xs:element name="username">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:minLength value="1"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <!-- Email: required, maximum 30 characters, must contain @ -->
                            <xs:element name="email">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:minLength value="3"/>
                                        <xs:maxLength value="30"/>
                                        <xs:pattern value="[^@\s]+@[^@\s]+\.[^@\s]+"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <!-- First name: required -->
                            <xs:element name="firstname">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:minLength value="1"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <!-- Last name: required -->
                            <xs:element name="lastname">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:minLength value="1"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <!-- ID number: numeric, maximum 5 digits -->
                            <xs:element name="idnumber">
                                <xs:simpleType>
                                    <xs:restriction base="xs:positiveInteger">
                                        <xs:maxInclusive value="99999"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <!-- Password: minimum 8 chars, uppercase + number -->
                            <xs:element name="password">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:minLength value="8"/>
                                        <xs:pattern value=".*[A-Z].*"/>
                                        <xs:pattern value=".*[0-9].*"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <!-- City: required -->
                            <xs:element name="city">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:minLength value="1"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <!-- Country: required -->
                            <xs:element name="country">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:minLength value="1"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>